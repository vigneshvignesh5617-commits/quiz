# MongoDB connection string
# Local example: mongodb://127.0.0.1:27017/quizmaster
# Atlas example: mongodb+srv://<user>:<password>@cluster0.mongodb.net/quizmaster
MONGODB_URI=mongodb://127.0.0.1:27017/quizmaster

# Generate a unique random value of at least 32 characters for signed sessions.
AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Optional: only users who provide this server-side token during registration become admins.
# Replace this placeholder with a unique random value before use.
ADMIN_BOOTSTRAP_TOKEN=replace-with-a-separate-random-admin-token

# Password recovery mail (Resend)
RESEND_API_KEY=re_replace-with-your-resend-api-key
EMAIL_FROM=QuizMaster <onboarding@resend.dev>
APP_URL=http://localhost:3000
